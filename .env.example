# Space Debris Tracking System - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=space_catalog

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=space_debris
POSTGRES_USER=spaceuser
POSTGRES_PASSWORD=your_postgres_password_here

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# =============================================================================
# STREAMING & MESSAGING
# =============================================================================

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELESCOPE_IMAGES=telescope-images
KAFKA_TOPIC_RADAR_DATA=radar-data
KAFKA_TOPIC_TLE_UPDATES=tle-updates
KAFKA_CONSUMER_GROUP=space-debris-tracker
KAFKA_AUTO_OFFSET_RESET=earliest

# =============================================================================
# API & AUTHENTICATION
# =============================================================================

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys
API_KEY_HEADER=X-API-Key
API_RATE_LIMIT_PER_MINUTE=60

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false
API_LOG_LEVEL=info

# Dashboard Server
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# =============================================================================
# ML MODEL CONFIGURATION
# =============================================================================

# Model Paths
YOLO_MODEL_PATH=models/yolov7_space_debris.pt
DINO_MODEL_PATH=models/dinov2_vitb14
PINN_MODEL_PATH=models/pinn_orbit_predictor.pth
TRANSFORMER_MODEL_PATH=models/trajectory_transformer.pth
MAMBA_MODEL_PATH=models/mamba2_predictor.pth

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
TORCH_DEVICE=cuda
MIXED_PRECISION=true
COMPILE_MODELS=true

# Inference Configuration
DETECTION_CONFIDENCE_THRESHOLD=0.25
DETECTION_IOU_THRESHOLD=0.45
TRACKING_MAX_AGE=70
TRACKING_MIN_HITS=3

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/space_debris_tracker.log

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Space-Track.org (for TLE updates)
SPACETRACK_USERNAME=your_spacetrack_username
SPACETRACK_PASSWORD=your_spacetrack_password
SPACETRACK_API_URL=https://www.space-track.org

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@spacedebris.local
SMTP_USE_TLS=true

# SMS Notifications (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# ALERTING CONFIGURATION
# =============================================================================

# Alert Thresholds
COLLISION_PROBABILITY_THRESHOLD=0.0001
MISS_DISTANCE_THRESHOLD_KM=1.0
TIME_TO_CONJUNCTION_THRESHOLD_HOURS=72

# Alert Channels
ENABLE_EMAIL_ALERTS=true
ENABLE_SMS_ALERTS=false
ENABLE_WEBSOCKET_ALERTS=true

# =============================================================================
# MCP (Multi-Agent) CONFIGURATION
# =============================================================================

# MCP Broker
MCP_BROKER_URL=tcp://localhost:5555
MCP_AGENT_PREFIX=sat_
MCP_HEARTBEAT_INTERVAL_SECONDS=30

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Environment
ENVIRONMENT=development  # development, staging, production

# Resource Limits
MAX_WORKERS=10
MAX_MEMORY_GB=12
GPU_MEMORY_FRACTION=0.9

# Feature Flags
ENABLE_GPU_ACCELERATION=true
ENABLE_DISTRIBUTED_TRAINING=false
ENABLE_MODEL_COMPILATION=true
ENABLE_QUANTIZATION=true
ENABLE_TELEMETRY=true

# =============================================================================
# DATA PATHS
# =============================================================================

# Data Directories
DATA_DIR=data
MODELS_DIR=models
LOGS_DIR=logs
CACHE_DIR=cache
CHECKPOINTS_DIR=checkpoints

# Dataset Paths
TELESCOPE_IMAGES_DIR=data/telescope_images
RADAR_DATA_DIR=data/radar_data
TLE_DATA_DIR=data/tle_data
TRAINING_DATA_DIR=data/training
VALIDATION_DATA_DIR=data/validation

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test Database (separate from production)
TEST_NEO4J_URI=bolt://localhost:7688
TEST_POSTGRES_DB=space_debris_test
TEST_REDIS_DB=1

# Test Settings
RUN_INTEGRATION_TESTS=false
RUN_PERFORMANCE_TESTS=false
TEST_DATA_DIR=tests/data
MOCK_EXTERNAL_SERVICES=true

# =============================================================================
# SECURITY
# =============================================================================

# Secrets Management
USE_VAULT=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your_vault_token

# Encryption
ENCRYPT_AT_REST=false
ENCRYPTION_KEY=your_encryption_key_here

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Batch Processing
BATCH_SIZE=16
GRADIENT_ACCUMULATION_STEPS=4
NUM_WORKERS=4
PREFETCH_FACTOR=2

# Caching
ENABLE_REDIS_CACHE=true
CACHE_TTL_SECONDS=3600
ENABLE_RESPONSE_CACHE=true

# Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Debug Mode
DEBUG=false
RELOAD_ON_CHANGE=false
SHOW_STACKTRACE=true

# Profiling
ENABLE_PROFILING=false
PROFILE_OUTPUT_DIR=profiles

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 2. For production, use environment variables or secrets management (Vault, AWS Secrets Manager)
# 3. Never commit .env file to version control
# 4. Rotate secrets regularly
# 5. Use strong passwords (min 16 characters, mixed case, numbers, symbols)
#
